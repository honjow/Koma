{
  "app": {
    "bundleName": "com.honjow.koma",
    "vendor": "koma",
    "versionCode": 25,
    "versionName": "1.5.6",
    "icon": "$media:app_icon_layered",
    "alternateIcons": [
      { "name": "lake", "icon": "$media:app_icon_lake_layered" },
      { "name": "plum", "icon": "$media:app_icon_plum_layered" },
      { "name": "cinnabar", "icon": "$media:app_icon_cinnabar_layered" },
      { "name": "paper", "icon": "$media:app_icon_paper_layered" },
      { "name": "night", "icon": "$media:app_icon_night_layered" }
    ],
    "label": "$string:app_name",
    "cloudStructuredDataSyncEnabled": true,
    "assetAccessGroups": [
      "koma_remote_server_credentials",
      "koma_tracker_credentials"
    ],
    "targetAPIVersion": 26,
    "minAPIVersion": 23,
    "apiReleaseType": "Release26"
  }
}
