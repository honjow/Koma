{
  "module": {
    "name": "entry",
    "type": "entry",
    "mainElement": "EntryAbility",
    "extensionAbilities": [
      { "name": "KomaMaintenanceAbility", "srcEntry": "./ets/maintenance/KomaMaintenanceAbility.ets", "type": "workScheduler", "exported": false }
    ],
    "requestPermissions": [
      { "name": "ohos.permission.INTERNET" },
      { "name": "ohos.permission.GET_NETWORK_INFO" },
      { "name": "ohos.permission.DISTRIBUTED_DATASYNC", "reason": "$string:device_sync_cloud_permission", "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } },
      { "name": "ohos.permission.KEEP_BACKGROUND_RUNNING" },
      { "name": "ohos.permission.FILE_ACCESS_PERSIST" },
      { "name": "ohos.permission.VIBRATE" },
      { "name": "ohos.permission.HDR_BRIGHTNESS" },
      { "name": "ohos.permission.ACCESS_BIOMETRIC", "reason": "$string:library_privacy_auth_permission", "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } },
      { "name": "ohos.permission.PRIVACY_WINDOW", "reason": "$string:library_privacy_window_permission", "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } },
      { "name": "ohos.permission.CAMERA", "reason": "$string:camera_permission_reason", "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon_layered",
        "label": "$string:EntryAbility_label",
        "launchType": "singleton",
        "continuable": true,
        "backgroundModes": ["dataTransfer"],
        "exported": true,
        "startWindowIcon": "$media:startup_foreground",
        "startWindowBackground": "$color:start_window_background",
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["ohos.want.action.home"]
          },
          {
            "entities": ["entity.system.browsable"],
            "actions": ["ohos.want.action.viewData"],
            "uris": [{ "scheme": "koma", "host": "tracker", "pathStartWith": "callback" }]
          }
        ]
      }
    ],
    "deviceTypes": ["phone", "tablet", "2in1"],
    "deliveryWithInstall": true,
    "pages": "$profile:main_pages"
  }
}
