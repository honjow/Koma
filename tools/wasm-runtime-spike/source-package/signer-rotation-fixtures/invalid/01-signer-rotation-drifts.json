{
  "cases": [
    {
      "case": "display-text-as-trust-identity",
      "expectRejectContains": "displayTextIsTrustIdentity",
      "mutations": [
        {
          "path": "identityBinding.displayTextIsTrustIdentity",
          "value": true
        }
      ]
    },
    {
      "case": "signature-signer-id-mismatch",
      "expectRejectContains": "signatureMetadata.signerId mismatch",
      "mutations": [
        {
          "path": "signatureMetadata.signerId",
          "value": "signer:other-lab"
        }
      ]
    },
    {
      "case": "signature-key-id-mismatch",
      "expectRejectContains": "signatureMetadata.keyId mismatch",
      "mutations": [
        {
          "path": "signatureMetadata.keyId",
          "value": "key:other-lab-2026"
        }
      ]
    },
    {
      "case": "real-signature-verification-claim",
      "expectRejectContains": "REAL_VERIFICATION_CLAIM_REJECTED",
      "mutations": [
        {
          "path": "signatureMetadata.realVerificationPerformed",
          "value": true
        }
      ]
    },
    {
      "case": "unapproved-signer-change",
      "expectRejectContains": "unapproved signer change",
      "mutations": [
        {
          "path": "candidatePackage.signerId",
          "value": "signer:other-lab"
        },
        {
          "path": "signatureMetadata.signerId",
          "value": "signer:other-lab"
        }
      ]
    },
    {
      "case": "unapproved-key-rotation",
      "expectRejectContains": "unapproved key rotation",
      "mutations": [
        {
          "path": "candidatePackage.keyId",
          "value": "key:koma-private-lab-2027"
        },
        {
          "path": "signatureMetadata.keyId",
          "value": "key:koma-private-lab-2027"
        }
      ]
    },
    {
      "case": "cross-package-rotation",
