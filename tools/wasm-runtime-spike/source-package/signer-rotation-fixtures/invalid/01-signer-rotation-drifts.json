        {
          "path": "rotationPolicy.approved.packageId",
          "value": "koma.local.other-fixture"
        }
      ]
    },
    {
      "case": "stale-rotation-policy",
      "expectRejectContains": "rotationPolicy.approved expired",
      "mutations": [
        {
          "path": "rotationPolicy.approved.notAfter",
          "value": "2026-05-02T00:00:00Z"
        }
      ]
