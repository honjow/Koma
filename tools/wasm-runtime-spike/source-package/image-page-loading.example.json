  "cachePolicy": {
    "hostBuildsFinalKey": true,
    "deterministicVersion": 1,
    "forbidRawUrls": true,
    "forbidHeaders": true,
    "forbidCredentials": true,
    "forbidLocalPaths": true,
    "staleBehavior": {
      "hostOwned": true,
      "allowedStates": [
