{
  "schemaVersion": 1,
  "package": {
    "id": "local.test.koma.fixture",
    "name": "Koma Local WASM Fixture",
    "version": "0.1.0",
    "language": "en",
    "type": "wasm-source-fixture",
    "nsfw": false,
    "author": "Koma test fixture",
    "description": "Local-only fixture manifest for validating Koma's WASM source package boundary.",
    "icon": "icon.placeholder.txt"
  },
  "runtime": {
    "abi": "koma-source-abi-v0.1",
    "hostAbi": "koma-host-v0.1-fixture-http-html",
    "wasm": {
      "path": "../../../entry/src/main/resources/rawfile/test/rust_source_runtime_fixture.wasm",
      "sha256": "5e03c5dedf562bbd65b0e35eeeb3a60c89eab59e9a25facae2402bf5926ab3a3",
      "build": {
        "kind": "rustc-no-std-fixture",
        "script": "../run-rust-fixture.sh",
        "artifactPath": "build/rust_source_fixture.wasm"
      }
    },
    "limits": {
      "maxMemoryPages": 2,
      "maxPayloadBytes": 1048576,
      "maxWasmBytes": 131072
    },
    "requiredHostImports": [
      {
        "module": "koma_host",
        "name": "log"
      },
      {
        "module": "koma_host",
        "name": "check_cancel"
      },
      {
        "module": "koma_host",
        "name": "http_request"
      },
      {
        "module": "koma_host",
        "name": "html_parse"
      },
      {
        "module": "koma_host",
        "name": "html_select"
      },
      {
        "module": "koma_host",
        "name": "html_attr"
      },
      {
        "module": "koma_host",
        "name": "html_text"
      },
      {
        "module": "koma_host",
        "name": "html_close"
      }
    ]
  },
  "capabilities": {
    "search": true,
    "detail": true,
    "chapterList": true,
    "pageList": true,
    "imageUrl": false
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "fixtureLabel": {
        "type": "string",
        "title": "Fixture label",
        "default": "fixture"
      }
    },
    "required": []
  },
  "permissions": {
    "network": false,
    "hostImports": [
      "koma_host.log",
      "koma_host.check_cancel",
      "koma_host.http_request",
      "koma_host.html_parse",
      "koma_host.html_select",
      "koma_host.html_attr",
      "koma_host.html_text",
      "koma_host.html_close"
    ],
    "experimentalHttpFixture": {
      "enabled": true,
      "allowedHost": "fixture.koma.local",
      "allowedMethods": [
        "GET"
      ],
      "responseKinds": [
        "bodyJson",
        "bodyText"
      ],
      "maxRequestBytes": 2048,
      "maxResponseBytes": 4096,
      "networkPerformed": false
    },
    "experimentalHtmlFixture": {
      "enabled": true,
      "selectorSubset": [
        "article.manga-card",
        "h3.title",
        "a.chapter"
      ],
      "allowedAttributes": [
        "data-id",
        "data-page-id"
      ],
      "maxHtmlBytes": 4096,
      "maxStringBytes": 512,
      "networkPerformed": false
    }
  },
  "contentPolicy": {
    "publicIndex": false,
    "marketplace": false,
    "builtInSource": false,
    "remoteInstall": false
  }
}
