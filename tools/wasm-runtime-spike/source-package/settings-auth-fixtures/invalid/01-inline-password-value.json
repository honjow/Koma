        "label": "Account password",
        "required": true,
        "password": "hunter2"
      }
    ],
    "auth": {
      "designOnly": true,
      "hostOwnedStorage": true,
      "sourceStoresCredentials": false,
      "operations": {
        "login": {
          "designOnly": true,
          "runtimeEnabled": false
        }
      },
      "errors": []
    },
    "credentialPolicy": {
      "hostOwnedStorage": true,
      "hostOwnedSession": true,
      "sourceStoresCredentials": false,
      "sourceOwnsCookieJar": false,
