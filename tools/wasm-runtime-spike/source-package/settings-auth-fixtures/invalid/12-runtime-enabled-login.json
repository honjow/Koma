{
  "case": "runtime enabled login is rejected",
  "expectRejectContains": "runtimeEnabled must be false",
  "input": {
    "boundaryVersion": 1,
    "currentRuntime": {
      "network": false,
      "hostImports": [
        "koma_host.log",
        "koma_host.check_cancel"
      ]
    },
    "settings": [],
    "auth": {
      "designOnly": true,
      "hostOwnedStorage": true,
      "sourceStoresCredentials": false,
      "operations": {
        "login": {
          "designOnly": true,
          "runtimeEnabled": true
        }
      },
      "errors": []
    },
    "credentialPolicy": {
      "hostOwnedStorage": true,
      "hostOwnedSession": true,
      "sourceStoresCredentials": false,
      "sourceOwnsCookieJar": false,
      "redactLogs": true,
      "denyRawAuthorizationHeaders": true,
      "denyRawCookies": true,
      "denyAppPrivatePathLeaks": true
    }
  }
}
